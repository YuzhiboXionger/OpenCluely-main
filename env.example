# DeepSeek API Configuration
# Get your API key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: override the model or endpoint
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Speech Recognition Configuration (Doubao only)
# Where AI answers triggered by voice are shown: chat, overlay or both
SPEECH_RESPONSE_TARGET=both

# Audio input source: microphone or system (system = loopback capture, use
# this when wearing headphones in a meeting)
AUDIO_INPUT_SOURCE=microphone

# Optional: Doubao (Volcengine) streaming speech recognition
# Configure via Settings > Speech Recognition > Doubao, or fill in below.
# Use either DOUBAO_API_KEY, or DOUBAO_APP_ID + DOUBAO_ACCESS_TOKEN.
DOUBAO_API_KEY=
DOUBAO_APP_ID=
DOUBAO_ACCESS_TOKEN=
DOUBAO_RESOURCE_ID=volc.seedasr.sauc.duration
# Dual-pass recognition: better accuracy, slightly higher sentence-end latency
DOUBAO_ENABLE_NONSTREAM=true
